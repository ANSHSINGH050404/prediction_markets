// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum MarketStatus {
  draft
  active
  closed
  resolved
  cancelled
}

enum PredictionStatus {
  active
  locked
  scored
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  totalPoints Int      @default(0)
  accuracy    Float    @default(0)
  rank        Int?

  predictions          Prediction[]
  badges               Badge[]               @relation("UserBadges")
  leaderboardSnapshots LeaderboardSnapshot[]
  dailyStreaks         DailyStreak[]
}

model Market {
  id               String       @id @default(cuid())
  title            String
  description      String?
  category         String // politics, sports, economy, tech
  status           MarketStatus @default(draft)
  endTime          DateTime
  resolvedAt       DateTime?
  correctOutcomeId String?

  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())

  outcomes    Outcome[]
  predictions Prediction[]
}

model Outcome {
  id       String @id @default(cuid())
  marketId String
  title    String // YES / NO / BJP / Congress

  market      Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  predictions Prediction[]
}

model Prediction {
  id           String           @id @default(cuid())
  userId       String
  marketId     String
  outcomeId    String
  confidence   Int // 1-100
  pointsEarned Int?
  status       PredictionStatus @default(active)
  createdAt    DateTime         @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  market  Market              @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome Outcome             @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  history PredictionHistory[]

  @@unique([userId, marketId])
}

model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  accuracy  Float
  rank      Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String @id @default(cuid())
  name        String
  description String

  users User[] @relation("UserBadges")
}

model PredictionHistory {
  id           String   @id @default(cuid())
  predictionId String
  oldOutcomeId String
  newOutcomeId String
  editedAt     DateTime @default(now())

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

model Season {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  markets Market[]
}

model DailyStreak {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  predicted Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}